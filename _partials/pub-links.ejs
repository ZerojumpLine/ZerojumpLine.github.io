```{=html}
<%
// Data-only listing for the Publications page: maps each paper's page to its
// `links:` (Publication / Preprint / Code / Website ...). publications.js turns
// these into small buttons on the visible list.
const data = {};
for (const item of items) {
  if (Array.isArray(item.links) && item.links.length) {
    data[item.path] = item.links.map((l) => ({ name: l.name, url: l.url, icon: l.icon }));
  }
}
%>
<script type="application/json" id="zl-pub-links"><%= JSON.stringify(data).replace(/</g, "\\u003c") %></script>
```
